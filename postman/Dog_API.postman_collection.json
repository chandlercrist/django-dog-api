{
  "info": {
    "name": "Dog API \u2014 10 required requests",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "breed_id",
      "value": ""
    },
    {
      "key": "dog_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 Breed POST",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/breeds/",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Labrador\",\n  \"size\": \"Large\",\n  \"friendliness\": 5,\n  \"trainability\": 5,\n  \"sheddingamount\": 4,\n  \"exerciseneeds\": 5\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) pm.collectionVariables.set(\"breed_id\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Breed GET list",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/breeds/"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Breed GET detail",
